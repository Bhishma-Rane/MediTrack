DATABASE_URL=sqlite:///./data/meditrack.db
# Set all three to enable real Twilio delivery; otherwise local dry-run mode is used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Required to enable the Admin portal. Use a secret value and do not commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-secret
